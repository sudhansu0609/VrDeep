# FaceFusion is a clone of an upstream repository with its own .git, plus a
# venv and ~37 GB of model weights. It is a dependency of this project, not
# part of it.
/facefusion/

# Renders, temp frame dumps, extracted source faces, the app log. Tens of GB,
# all of it reproducible from the inputs.
/output/
/output2/
/output5/

# Source faces and target videos are personal media, and large.
/input/
IMG_*.jpg

__pycache__/
*.py[cod]

# Hand-made snapshots taken before risky config edits. Useful locally, noise
# in history - git is the point of having them.
*.bak

# The RIFE frame-interpolation weights. 10 MB of downloadable model, not source
# - scripts/rife_worker.py fetches them on demand (see --install-model).
/models/

# The setup wizard's marker and log (scripts/app_installer, see installer/README.md
# in the template repo). facefusion/venv is already covered by /facefusion/ above.
/installer/installed.json
/logs/
installer/setup.running
